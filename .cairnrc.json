{
  "checks": {
    "coverage": false
  },
  "ignore": [
    ".agents/**",
    ".changeset/**",
    ".claude/**",
    ".github/**",
    "CHANGELOG.md",
    "coverage/**",
    "dist/**",
    "node_modules/**"
  ],
  "naming": {
    "dirSummary": "_SUMMARY.md",
    "fileSummarySuffix": ".summary.md"
  },
  "refsStampCommand": "pnpm format && pnpm stamp",
  "roots": ["."],
  "stampCommand": "pnpm format && pnpm stamp",
  "thresholdLines": 30
}
