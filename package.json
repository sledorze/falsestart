{
  "name": "@sledorze/falsestart",
  "version": "0.4.0",
  "description": "Blocks risky code patterns the instant an AI writes them — before the file lands, not just at CI. Also enforces structure/architecture conventions.",
  "keywords": [
    "claude",
    "agents",
    "hooks",
    "static-analysis",
    "architecture"
  ],
  "license": "MIT",
  "author": "Stéphane Le Dorze",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sledorze/falsestart.git"
  },
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "falsestart": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rules/*": "./rules/*",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "dist",
    "docs",
    "rules"
  ],
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsc -p tsconfig.build.json && pnpm run bundle-cli",
    "bundle-cli": "esbuild dist/cli.js --bundle --platform=node --format=esm --outfile=dist/cli.js --allow-overwrite --external:@ast-grep/napi --banner:js=\"import { createRequire as __cr } from 'module'; const require = __cr(import.meta.url);\"",
    "check": "cairn check --refs --prose-refs --report-deletions",
    "coverage": "vitest run --coverage",
    "coverage:ci": "vitest run --coverage --coverage.thresholds.autoUpdate=false",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "mutation": "stryker run",
    "mutation:changed": "bash scripts/mutate-changed.sh",
    "prepare": "lefthook install || true",
    "release": "changeset publish",
    "stamp": "cairn check --summaries-only --refs --stamp",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm coverage:ci && pnpm build && pnpm check && pnpm mutation:changed"
  },
  "peerDependencies": {
    "@effect/platform-node": "^4.0.0-rc.111",
    "effect": "^4.0.0-rc.111"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@sledorze/cairn": "^0.14.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^26.1.1",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "effect": "4.0.0-rc.111",
    "esbuild": "^0.28.1",
    "lefthook": "^2.1.0",
    "oxlint": "1.80.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.0",
    "picomatch": "^4.0.5",
    "yaml": "^2.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/sledorze/falsestart/issues"
  },
  "homepage": "https://github.com/sledorze/falsestart#readme"
}
